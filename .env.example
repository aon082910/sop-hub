# Copy this file to .env and fill in real values before running docker-compose
# (or Docker/Unraid directly -- these are the same env vars either way).

# Any long random string -- signs session/auth tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Unraid convention: which host uid/gid should own everything under /config.
# 99/100 is Unraid's built-in "nobody" user/"users" group.
PUID=99
PGID=100
TZ=Etc/UTC

# --- Embedded Postgres (lives under /config, no separate container) ---
POSTGRES_USER=sophub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sophub

# --- AI: which provider is used by default (ollama | anthropic | openai | custom) ---
AI_DEFAULT_PROVIDER=ollama

# Local AI via an Ollama instance you run elsewhere (e.g. another Unraid
# container or a LAN box) -- pull a vision-capable model there, e.g. `llava`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llava

# Cloud AI: Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Cloud AI: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloud/self-hosted: any OpenAI-compatible endpoint (LM Studio, vLLM, OpenRouter, etc.)
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=
