{
  "manifest_version": 3,
  "name": "SOP-Hub Capture",
  "version": "1.0.0",
  "description": "Record clicks across any site as an annotated, step-by-step SOP-Hub guide.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SOP-Hub Capture" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
